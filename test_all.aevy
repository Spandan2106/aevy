show("=== Variables and Arithmetic ===")

x = 10
y = 5

show(x + y)
show(x - y)
show(x * y)
show(x / y)

show("=== Conditions ===")

if x > y:
    show("Conditions work")
else:
    show("Conditions failed")

show("=== Loops ===")

for i in 0..3:
    show(i)

show("=== Functions ===")

func add(a, b) {
    return a + b
}

show(add(10, 20))

show("=== Recursion ===")

func factorial(n) {
    if n <= 1:
        return 1
    return n * factorial(n - 1)
}

show(factorial(5))

show("=== Lists ===")

numbers = [10, 20, 30]

append(numbers, 40)

show(numbers)
show(length(numbers))
show(sum(numbers))
show(contains(numbers, 20))

show("=== List Operations ===")

show(numbers[0])

numbers[1] = 25

show(numbers[1])

show("=== Dictionaries ===")

person = {"name": "Alex", "age": 20}

show(person["name"])
show(person["age"])

person["age"] = 21

show(person["age"])
show("age" in person)
show(length(person))

show("=== Dictionary Operations ===")

show(keys(person))
show(values(person))
show(has_key(person, "name"))

show("=== Strings ===")

show(upper("aevy"))
show(lower("HELLO"))
show(trim("  hello  "))
show(contains("programming", "gram"))

show("=== Type Conversions ===")

show(number("123"))
show(integer(3.8))
show(decimal("3.14"))
show(text(42))
show(boolean("True"))
show(boolean("False"))

show("=== Math Functions ===")

show(abs(-10))
show(min(5, 2))
show(max(5, 2))
show(round(3.6))

show("=== Dictionary Iteration ===")

for key in person:
    show(key)

show("=== ALL TESTS COMPLETED ===")